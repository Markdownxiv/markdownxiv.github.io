{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-preprints:answers:v6",
  "type": "array",
  "minItems": 1,
  "maxItems": 1,
  "prefixItems": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "basis"
      ],
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/hash"
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 35,
            "items": {
              "enum": [
                "0",
                "1",
                "2"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
