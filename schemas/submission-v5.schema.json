{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-preprints:submission:v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "repository_id",
    "submitter_id",
    "epoch_id",
    "epoch_hash",
    "metadata",
    "paper_sha256",
    "paper_size",
    "content_hash",
    "nonce",
    "answers",
    "assets",
    "intent",
    "author_homepages"
  ],
  "properties": {
    "protocol": {
      "const": "agent-preprints-v5"
    },
    "repository_id": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/repository_id"
    },
    "submitter_id": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/submitter_id"
    },
    "epoch_id": {
      "type": "string",
      "pattern": "^(dev-)?v5-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "epoch_hash": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/epoch_hash"
    },
    "metadata": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/metadata"
    },
    "paper_sha256": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/paper_sha256"
    },
    "paper_size": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,6}$"
    },
    "content_hash": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/content_hash"
    },
    "nonce": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/nonce"
    },
    "answers": {
      "$ref": "urn:agent-preprints:answers:v5"
    },
    "assets": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/assets"
    },
    "intent": {
      "$ref": "urn:agent-preprints:submission:v2#/properties/intent"
    },
    "author_homepages": {
      "description": "Ordered display URLs, excluded from Proof of Work. Length equals the author count.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          }
        ]
      }
    }
  }
}
