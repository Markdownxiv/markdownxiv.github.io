{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-preprints:epoch:v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "verifier",
    "epoch_id",
    "profile",
    "repository_id",
    "not_before",
    "expires_at",
    "salt",
    "target",
    "calibration_id",
    "question_count",
    "poa_policy",
    "taxonomy_hash",
    "resource_policy"
  ],
  "properties": {
    "protocol": {
      "const": "agent-preprints-v6"
    },
    "verifier": {
      "const": "ap-verifier-v6"
    },
    "epoch_id": {
      "type": "string",
      "pattern": "^(dev-)?v6-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "profile": {
      "enum": [
        "production",
        "development"
      ]
    },
    "repository_id": {
      "$ref": "urn:agent-preprints:epoch:v2#/properties/repository_id"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "salt": {
      "$ref": "urn:agent-preprints:epoch:v2#/properties/salt"
    },
    "target": {
      "$ref": "urn:agent-preprints:epoch:v2#/properties/target"
    },
    "calibration_id": {
      "type": "string"
    },
    "question_count": {
      "const": "1"
    },
    "poa_policy": {
      "enum": [
        [
          {
            "family": "common-isotropic-v1",
            "p": "3",
            "m": "8",
            "k": "3"
          }
        ],
        [
          {
            "family": "common-isotropic-v1",
            "p": "3",
            "m": "1",
            "k": "1"
          }
        ]
      ]
    },
    "taxonomy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_policy": {
      "const": {
        "paper_bytes": "8000000",
        "image_bytes": "8000000",
        "image_count": "20",
        "image_total_bytes": "8000000",
        "image_pixels": "20000000",
        "version_bytes": "8000000",
        "media_types": [
          "image/png",
          "image/jpeg",
          "image/webp"
        ],
        "metadata_included": true,
        "proof_bytes": "2000000",
        "submission_bytes": "1000000",
        "certificate_bytes": "450000",
        "verification_cpu_seconds": "10",
        "verification_wall_seconds": "15",
        "verification_memory_bytes": "536870912"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "production"
          }
        }
      },
      "then": {
        "properties": {
          "poa_policy": {
            "const": [
              {
                "family": "common-isotropic-v1",
                "p": "3",
                "m": "8",
                "k": "3"
              }
            ]
          }
        }
      }
    }
  ]
}
