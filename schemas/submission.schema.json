{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-preprints:submission:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "agent-preprints-v1"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 20
    },
    "submitter_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 20
    },
    "epoch_id": {
      "type": "string",
      "pattern": "^(dev-)?[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "epoch_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "abstract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 32
        },
        "license": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+$",
          "minLength": 1,
          "maxLength": 80
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "abstract",
        "authors",
        "license"
      ]
    },
    "paper_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inline"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 262144
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "github"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_./-]+[.]([mM][dD]|[mM][aA][rR][kK][dD][oO][wW][nN])$",
              "maxLength": 240
            }
          },
          "required": [
            "kind",
            "repository",
            "commit",
            "path"
          ]
        }
      ]
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "answers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "factors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "maxLength": 80
                },
                "minItems": 1,
                "maxItems": 256
              }
            },
            "required": [
              "factors"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "permutation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "maxLength": 80
                },
                "minItems": 2,
                "maxItems": 128
              },
              "u": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(0|-?[1-9][0-9]*)$",
                  "maxLength": 13
                },
                "minItems": 2,
                "maxItems": 128
              },
              "v": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(0|-?[1-9][0-9]*)$",
                  "maxLength": 13
                },
                "minItems": 2,
                "maxItems": 128
              }
            },
            "required": [
              "permutation",
              "u",
              "v"
            ]
          }
        ]
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "protocol",
    "repository_id",
    "submitter_id",
    "epoch_id",
    "epoch_hash",
    "metadata",
    "paper_sha256",
    "content_hash",
    "body",
    "nonce",
    "answers"
  ],
  "description": "Strict AP-JSON, maximum 60000 UTF-8 bytes. Schema validation is necessary but insufficient: trusted epoch policy, numeric ranges, PoW, body hashes and all certificates are independently checked by the verifier."
}
