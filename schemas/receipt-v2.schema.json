{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-preprints:receipt:v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receipt_version": {
      "const": "agent-preprints-receipt-v2"
    },
    "status": {
      "enum": [
        "accepted",
        "duplicate",
        "rejected",
        "retryable"
      ]
    },
    "paper_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "archived": {
      "type": "boolean"
    },
    "published": {
      "type": "boolean"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 20
    },
    "issue_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 20
    },
    "publication_status": {
      "enum": [
        "published",
        "pending",
        "not_archived"
      ]
    },
    "work_id": {
      "type": "string",
      "pattern": "^mx:[0-9]{4}[.][0-9]{5,10}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "work_url": {
      "type": "string",
      "format": "uri"
    },
    "discussion_url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "receipt_version",
    "status",
    "paper_id",
    "content_hash",
    "error_code",
    "message",
    "archived",
    "published",
    "url",
    "request_sha256",
    "repository_id",
    "issue_id",
    "publication_status",
    "work_id",
    "version",
    "work_url",
    "discussion_url"
  ]
}
