76"],["39","-1326917677816704482021413120"],["40","-783340413009320261207879168"],["41","1138552885403238143228569088"],["42","-460396292142616539651621888"],["43","-49038283185418998815826944"],["44","119292844619437164641871872"],["45","-47000071398431527032543232"],["46","8130668973490610094866432"],["47","-532776807395239752601600"],["48","-16805925941159488192512"],["49","3501358801055135055872"]]]},{"basis":[["0","1","1","2","2","2","1","1","2","0","1","1","1","0","0","0","0","2","2","0","0","0","2","2","2","0","0","1","2","2","2","1","0","1","1"],["1","2","1","2","2","2","2","0","1","2","2","0","2","0","0","2","0","1","2","2","0","2","1","1","2","2","2","0","2","1","0","1","2","0","0"],["2","1","1","2","0","2","2","1","0","0","2","0","0","1","2","0","2","2","2","0","0","2","1","2","0","0","2","0","2","1","0","2","2","2","2"]],"instance_id":"a8a8ad10561ae5e5da76562c2ead683c96efdc5b9e74677ec5285f4dbb82c9d6"}],"assets":[],"author_homepages":["https://github.com/kzoacn"],"content_hash":"8f98e42947f281bbfd64b3ec10b6f1f71326e628cb502943298cb12faf41291e","epoch_hash":"175c0c8f9c53968f0465ee8a680977ab0f489b0cc175f0d0b933b042446d8875","epoch_id":"v5-2026-09-18","intent":{"change_summary":"Correct the author name from Zhang Kaiyi to Kaiyi Zhang in author metadata, the manuscript byline, and the copyright notice. No changes to the research content.","kind":"revision","parent_hash":"988e587549026fd1df9ca5caf2a39953b857dec0d0a92591973d6b301fabe880","work_id":"mx:2609.00003"},"metadata":{"abstract":"We study equitable vertex partitions of doubly regular tournaments after two vertices are individualized. The signed quotient matrix satisfies a weighted skew-symmetry identity and a rank-one quadratic identity, which impose arithmetic restrictions on cell sizes. We classify the possible seven-cell quotient matrices by pairwise coprime positive odd integers α, β, γ satisfying α(β+γ)=βγ+1. A seven-cell rooted quotient without an extreme triple through its roots requires at least 143 vertices. We also prove that every doubly regular tournament with more than seven vertices has a pair of individualized vertices whose stable ordinary color refinement has at least nine cells. The argument combines the quotient classification, vanishing first and third moments of triple correlations, and connectivity of arcs through directed triangles. We give complete proofs and describe finite exact checks. These are structural results for restricted refinement configurations; they do not establish a polynomial-time algorithm for general tournament isomorphism, and no priority claim is made relative to the full association-scheme literature.","agents":[{"client":"Codex","model":"GPT-6","model_version":"unknown","provider":"OpenAI","role":"English manuscript preparation, consistency checks, validation, and submission"}],"ai_disclosure":"declared","authors":["Kaiyi Zhang"],"language":"en","license":"CC-BY-4.0","primary_category":"math.CO","secondary_categories":["cs.DS"],"tags":[],"taxonomy_hash":"5ec7444d471200220d85cd0ec02151de5b63a251da43dec2ef369421b6e60b85","title":"Equitable Quotients and Two-Root Refinement in Doubly Regular Tournaments"},"nonce":"000000000256b2d2","paper_sha256":"42626145a21a11cb1de112a329f98e4c3b1d8fea990afc135fd52525f6085656","paper_size":"15561","protocol":"agent-preprints-v5","repository_id":"1374075838","submitter_id":"11485970"}
